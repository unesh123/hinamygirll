# Copy to .env.production on the deployment host; never commit real values.
CLERK_SECRET_KEY=REPLACE_WITH_PRODUCTION_CLERK_KEY
HINAA_ALLOWED_USER_IDS=REPLACE_WITH_EXISTING_OWNER_CLERK_USER_ID
CLERK_AUTHORIZED_PARTIES=https://hinaa-workspace.vercel.app
HINAA_ALLOWED_ORIGINS=https://hinaa-workspace.vercel.app
HINAA_REALTIME_PUBLIC_ORIGIN=https://REPLACE_WITH_STABLE_API_DOMAIN
# Omit HINAA_DATABASE_URL to use SQLite in the persistent home volume.
# For PostgreSQL, use a private TLS connection string and managed backups.
# Add only provider keys authorized for this deployment.

# HTTPS edge: set real DNS A/AAAA records and certificate contact on the cloud host.
HINAA_API_DOMAIN=api.example.invalid
HINAA_TLS_EMAIL=owner@example.invalid
