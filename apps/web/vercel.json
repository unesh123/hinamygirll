{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://organised-advised-watches-min.trycloudflare.com/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://organised-advised-watches-min.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://organised-advised-watches-min.trycloudflare.com/health"
    },
    {
      "source": "/((?!api/|v1/|health|models/|assets/|worklets/|animations/|test-assets/).*)",
      "destination": "/index.html"
    }
  ]
}
