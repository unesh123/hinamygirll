# Copy this file to .env.local. The local file is ignored by Git.
# Never place these values in apps/web or any VITE_* variable.
HINAA_PROVIDER_MODE=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
# Claude (Anthropic Messages API). Use HINAA_CLAUDE_API_KEY or the standard
# ANTHROPIC_API_KEY. Do not copy ANTHROPIC_AUTH_TOKEN from Claude Code or an
# untrusted setup script into HINAA; that credential may belong to a different gateway/account.
HINAA_CLAUDE_API_KEY=
# Official Anthropic: HINAA_CLAUDE_BASE_URL=https://api.anthropic.com
# mwapi Claude-compatible gateway (evidenced working route):
# HINAA_CLAUDE_BASE_URL=https://api.mwapi.dev/v1
# HINAA_CLAUDE_PROTOCOL=anthropic
# Auto selects Anthropic Messages with Bearer authentication for api.mwapi.dev.
# Use openai-compatible only when a gateway explicitly requires chat completions.
# HINAA_CLAUDE_MODEL=claude-sonnet-5-5
# HINAA_CLAUDE_ALLOWED_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
# Claude brain tiers: fast = short chit-chat/voice, default = normal turns,
# deep = coding/website/multi-step planning with thinking. HINAA_CLAUDE_MODEL
# still overrides the default tier. Defaults are the current documented IDs.
# HINAA_CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
# HINAA_CLAUDE_MODEL_DEEP=claude-opus-5-5
# HINAA_CLAUDE_MODEL_FAST=claude-haiku-5-5
# Adaptive thinking effort for the deep tier: low|medium|high|xhigh|max
# HINAA_CLAUDE_THINKING_EFFORT=high
# Manual thinking budget, used only for pre-adaptive models (e.g. claude-sonnet-4-20250514)
# HINAA_CLAUDE_THINKING_BUDGET_TOKENS=8000
# Max model calls in one native tool loop
# HINAA_CLAUDE_TOOL_MAX_STEPS=8
# HINAA_CLAUDE_API_VERSION=2026-10-21
# Prompt cache lifetime for the system prompt and tool list: 5m|1h
# HINAA_CLAUDE_PROMPT_CACHE_TTL=5m
# Claude becomes the default brain when a key is set and HINAA_PROVIDER_MODE is unset
# HINAA_CLAUDE_PREFER_WHEN_KEYED=true

# QwenCloud — OpenAI-compatible Chat Completions, backend only. Use the API key
# generated at https://home.qwencloud.com/api-keys; never add it to Vite/browser code.
# HINAA_QWEN_API_KEY=
# HINAA_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# HINAA_QWEN_MODEL=qwen3.7-plus
# HINAA_QWEN_ALLOWED_MODELS=qwen3.7-plus,qwen3.7-max,qwen3.5-flash,qwen3.6-plus
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_CODEX_API_KEY=
# You.com real-time web intelligence. Keep this only in apps/api/.env.local.
# Do not place the value in apps/web, VITE_* variables, Git, or a browser console.
YDC_API_KEY=
# Optional endpoint/time overrides; the verified production defaults are used when omitted.
YOUCOM_BASE_URL=https://api.you.com
YOUCOM_CONTENTS_BASE_URL=https://ydc-index.io
YOUCOM_TIMEOUT_SECONDS=30
# Exa API — semantic web search, token-efficient highlights, and content extraction for coding agents
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=20
# Experiential Gateway — OpenAI Chat Completions at https://api.experientiallabs.ai/v1 for claude-opus-5.5
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=claude-opus-5.5
# Model and voice identifiers are configuration, not secrets.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-5-mini
OPENAI_CODEX_MODEL=gpt-5-mini
# auto uses OPENAI_CODEX_API_KEY first when present, then OPENAI_API_KEY.
HINAA_OPENAI_KEY_SOURCE=auto
AZURE_SPEECH_FEMALE_VOICE=hi-IN-SwaraNeural
AZURE_SPEECH_MALE_VOICE=hi-IN-MadhurNeural
# Comma-separated exact local development origins.
HINAA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Provider timeouts
# Media calls (STT/TTS) fail fast; the brain (LLM) gets a large budget because
# reasoning models (cx/gpt-5.6-sol) spend hidden tokens before the first token.
# HINAA_LLM_TIMEOUT_SECONDS=60

# Optional zero-credit local voice engine hooks.
# Commands must be local-only and must not call cloud services.
# STT receives {input} as a 16 kHz mono WAV path and prints transcript text to stdout.
# TTS receives {text}, {voice} and {output}; it must write a 16 kHz mono PCM WAV to {output}.
HINAA_LOCAL_COMMAND_TIMEOUT_SECONDS=12
HINAA_LOCAL_STT_COMMAND=
HINAA_LOCAL_TTS_COMMAND=

# Durable memory persistence. The launcher scripts set this automatically to
# .runtime/hinaa.db (file-backed SQLite) so learned facts survive API restarts.
# Tests and CI keep the explicit in-memory URL. For PostgreSQL set e.g.
# postgresql+psycopg://user:pass@host:5432/hinaa
HINAA_DATABASE_URL=sqlite+pysqlite:///./.runtime/hinaa.db
HINAA_PERSISTENCE_ENABLED=false
HINAA_AUTH_MODE=dev
HINAA_DEV_AUTH_SUBJECT=local-dev-user

# Fish Audio TTS (multilingual Nepali/English)
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_BASE_URL=https://api.fish.audio
# FISH_AUDIO_HINAA_VOICE_ID=
# FISH_AUDIO_HIRO_VOICE_ID=
# FISH_AUDIO_MODEL_ID=fish-speech-1.5

# TinyFish web-agent platform (https://agent.tinyfish.ai)
# TINYFISH_API_KEY=

# Cloud image generation fallback (used when local ComfyUI is offline)
# OPENAI_CODEX_API_KEY=
# OPENAI_CODEX_BASE_URL=https://api.hcnsec.cn/v1

# Magnific / Freepik — cloud image generation (HINAA's Image Studio + chat
# /image commands). Get a key at https://www.freepik.com/developers/dashboard/api-key
# Either variable works (MAGNIFIC_API_KEY takes precedence). Without a key,
# HINAA transparently falls back to a locally running ComfyUI.
MAGNIFIC_API_KEY=
FREEPIK_API_KEY=
# Fully optional overrides (defaults match docs.magnific.com):
# MAGNIFIC_BASE_URL=https://api.magnific.com
# MAGNIFIC_MODEL_QUALITY=flux-dev
# MAGNIFIC_MODEL_FAST=flux-2-turbo
# MAGNIFIC_TIMEOUT_SECONDS=240

# Stability AI Image Generation (core, SDXL 1024)
# STABILITYAI_API_KEY=

# PGSGrove AI Gateway (glm-5.3-flash, deepseek-v4.1-flash-turbo)
# PGSGROVE_API_KEY=
# PGSGROVE_BASE_URL=https://api.pgsgrove.com/v1
# PGSGROVE_MODEL=glm-5.3-flash

# XKiro AI Gateway (qwen/qwen3.8-max:free, qwen/qwen3.7-flash:free)
# XKIRO_API_KEY=
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# XKIRO_MODEL=qwen/qwen3.8-max:free
# Pinned Qwen family only — do not add other families or a "*" wildcard here.
# XKIRO_ALLOWED_MODELS=qwen/qwen3.8-max:free,qwen/qwen3.8-omni-flash:free,qwen/qwen3.7-flash:free,qwen/qwen3.7-max:free,qwen/qwen3.6-max-preview:free,qwen/qwen3.5-flash:free

# Silent cross-family fallback is OFF by default. Only set true if you
# explicitly want Hina to degrade to another model family when the pinned
# brain fails, instead of failing visibly.
# HINAA_AUTO_FALLBACK_ENABLED=false

# Bright Data Remote Scraping Browser (Playwright / CDP) & SERP API
# BRD_BROWSER_WS=wss://brd-customer-hl_a92248a9-zone-scraping_browser1:PASSWORD@brd.superproxy.io:9222
# BRD_SELENIUM_URL=https://brd-customer-hl_a92248a9-zone-scraping_browser1:PASSWORD@brd.superproxy.io:9515
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_SERP_ZONE=serp_api1

# Captcha Solvers (Cloudflare Turnstile, reCAPTCHA v2/v3)
# CAPSOLVER_API_KEY=
# EZ_CAPTCHA_API_KEY=

# Video generation via fal.ai — the only real MP4 path. Get a key at
# https://fal.ai/dashboard/keys and buy prepaid credits (pay-as-you-go, no
# subscription; Kling v3 Pro is roughly $0.14/s, so an 8 s clip is about
# $1.12 — re-check the live price on fal's model page before budgeting).
# Without FAL_KEY, video generation is BLOCKED and Hina says so honestly.
# The key lives here in the backend env only — never in chat or the frontend.
FAL_KEY=
# Video endpoint. Default is Kling v3 Pro. Do NOT set this to fal-ai/veo3.1*
# (any tier): fal deprecates the whole Veo 3.1 tree on 17 Nov 2026.
HINAA_FAL_VIDEO_ENDPOINT=fal-ai/kling-video/v3/pro/text-to-video

# Frontier brain selection. Set this to claude, gemini, openai, qwen or xkiro
# to make that provider the brain — but only if its API key is actually
# configured above; otherwise Hina stays on the pinned Qwen gateway and says
# why. A frontier model is a key + a paid account away, not a code change.
# HINAA_PRIMARY_BRAIN=claude
