# Copy this file to .env.local. The local file is ignored by Git.
# Never place these values in apps/web or any VITE_* variable.
HINAA_PROVIDER_MODE=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
# Model and voice identifiers are configuration, not secrets.
GEMINI_MODEL=gemini-3.6-flash
AZURE_SPEECH_FEMALE_VOICE=ne-NP-HemkalaNeural
AZURE_SPEECH_MALE_VOICE=ne-NP-SagarNeural
# Comma-separated exact local development origins.
HINAA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

