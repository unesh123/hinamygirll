# Only the API source, dependencies and container entrypoint enter the build context.
*
!Dockerfile
!apps/
!apps/api/
!apps/api/requirements.txt
!apps/api/hinaa_api/
!apps/api/hinaa_api/**
!scripts/
!scripts/start-api-container.py
**/__pycache__/
**/*.pyc
**/.env*
**/*.db
**/*.sqlite*
**/.hina/
**/.hinaa/
**/data/
**/exports/
**/uploads/

# Alembic migrations (run by `alembic upgrade head` inside the API image)
!apps/api/alembic.ini
!apps/api/alembic/
!apps/api/alembic/**

# Reviewer compose stack: static web build (infra/compose/web.Dockerfile)
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/
!packages/**
!apps/web/
!apps/web/**
!apps/desktop/package.json
!infra/
!infra/compose/
!infra/compose/**
**/node_modules/
**/dist/
