@echo off
setlocal
cd /d "%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Continue'; Write-Host '==================================================' -ForegroundColor Magenta; Write-Host ' HINAA — Qwen Readiness Diagnostic' -ForegroundColor Magenta; Write-Host '==================================================' -ForegroundColor Magenta; $envPath = Join-Path $PWD 'apps\api\.env.local'; Write-Host ''; Write-Host '1. Local backend environment file'; if (-not (Test-Path $envPath)) { Write-Host ('   MISSING: ' + $envPath) -ForegroundColor Red; Write-Host '   Create this file from apps\api\.env.example, then add HINAA_QWEN_API_KEY=your_key.' -ForegroundColor Yellow } else { $lines = Get-Content $envPath; $aliases = @('HINAA_QWEN_API_KEY', 'QWEN_API_KEY', 'DASHSCOPE_API_KEY'); $found = $false; foreach ($name in $aliases) { $entry = $lines | Where-Object { $_ -match ('^\s*' + [regex]::Escape($name) + '\s*=') } | Select-Object -First 1; if ($entry) { $found = $true; $value = ($entry -split '=', 2)[1].Trim(); if ($value) { Write-Host ('   ' + $name + ': configured (value hidden)') -ForegroundColor Green } else { Write-Host ('   ' + $name + ': EMPTY') -ForegroundColor Red } } }; if (-not $found) { Write-Host '   No Qwen key alias found. Add HINAA_QWEN_API_KEY=your_key.' -ForegroundColor Red }; $endpoint = $lines | Where-Object { $_ -match '^\s*HINAA_QWEN_BASE_URL\s*=' } | Select-Object -First 1; if ($endpoint) { Write-Host ('   Base URL: ' + (($endpoint -split '=', 2)[1].Trim())) } else { Write-Host '   Base URL: default QwenCloud compatible endpoint' } }; Write-Host ''; Write-Host '2. Running backend status'; try { $providers = Invoke-RestMethod -Uri 'http://127.0.0.1:8000/v1/providers' -Method Get -TimeoutSec 3 -ErrorAction Stop; $qwen = $providers | Where-Object { $_.id -eq 'qwen' } | Select-Object -First 1; if (-not $qwen) { Write-Host '   Qwen is not exposed by this backend process.' -ForegroundColor Red; Write-Host '   The running backend is older than the Qwen update. Pull the branch and run restart.bat.' -ForegroundColor Yellow } else { $color = if ($qwen.state -eq 'healthy') { 'Green' } else { 'Red' }; Write-Host ('   Qwen status: ' + $qwen.state) -ForegroundColor $color; Write-Host ('   Detail: ' + $qwen.userMessage); Write-Host ('   Models: ' + (($qwen.capabilities | Where-Object { $_ -like 'model:*' }) -join ', ')) } } catch { Write-Host '   Backend is offline at http://127.0.0.1:8000.' -ForegroundColor Red; Write-Host '   Start or restart HINAA, then run this diagnostic again.' -ForegroundColor Yellow }; Write-Host ''; Write-Host 'No secret values were printed.' -ForegroundColor DarkGray; pause"
exit /b %ERRORLEVEL%
