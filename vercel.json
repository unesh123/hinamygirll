{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --dir apps/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/health"
    },
    {
      "source": "/healthz",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://killing-jennifer-spots-cornell.trycloudflare.com/readyz"
    },
    {
      "source": "/((?!api/|v1/|health|healthz|readyz|models/|assets/|worklets/|animations/|test-assets/).*)",
      "destination": "/index.html"
    }
  ]
}
