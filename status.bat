@echo off
setlocal
cd /d "%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Write-Host '==================================================' -ForegroundColor Magenta; Write-Host ' HINAA — Status' -ForegroundColor Magenta; Write-Host '==================================================' -ForegroundColor Magenta; Write-Host ''; $pidDir = Join-Path $PWD '.runtime\pids'; function Get-ProcStatus($Name) { $f = Join-Path $pidDir \"$Name.pid\"; if (Test-Path $f) { $p = Get-Content $f; $proc = Get-Process -Id $p -ErrorAction SilentlyContinue; if ($proc) { Write-Host \"$($Name) (PID $p): RUNNING\" -ForegroundColor Green } else { Write-Host \"$($Name) (PID $p): NOT RUNNING (stale PID file)\" -ForegroundColor Yellow } } else { Write-Host \"$($Name): NOT RUNNING\" -ForegroundColor DarkGray } }; Get-ProcStatus 'backend'; Get-ProcStatus 'frontend'; Write-Host ''; Write-Host 'Backend Health:'; try { $res = Invoke-RestMethod -Uri 'http://127.0.0.1:8000/health/live' -Method Get -TimeoutSec 2 -ErrorAction Stop; Write-Host '  OK (8000)' -ForegroundColor Green } catch { Write-Host '  Offline' -ForegroundColor DarkGray }; Write-Host 'Frontend UI:'; try { $res = Invoke-WebRequest -Uri 'http://127.0.0.1:5173/' -Method Get -UseBasicParsing -TimeoutSec 2 -ErrorAction Stop; Write-Host '  OK (5173)' -ForegroundColor Green } catch { Write-Host '  Offline' -ForegroundColor DarkGray }; Write-Host ''; pause"
exit /b %ERRORLEVEL%
