# ==========================================
# HINAA OS - Phase 17 Background Task Worker Dockerfile
# Durable Task Queue consumer, isolated worker
# ==========================================

# Stage 1: Build & Dependencies
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/requirements.txt* /build/

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt || \
    pip install --no-cache-dir --prefix=/install fastapi pydantic sqlalchemy httpx redis

# Stage 2: Minimal Runtime
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

RUN groupadd -g 10001 hinaa && \
    useradd -u 10001 -g hinaa -s /bin/sh -m -d /home/hinaa hinaa

RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY apps/api/hinaa_api /app/hinaa_api
COPY apps/api/pyproject.toml /app/

RUN mkdir -p /app/data /app/backups && \
    chown -R hinaa:hinaa /app /home/hinaa

USER hinaa:hinaa

ENV PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    HINAA_DEPLOYMENT_PROFILE=CLOUD_PRODUCTION \
    HINAA_DATABASE_URL="sqlite:////app/data/hinaa_autopilot.db"

CMD ["python", "-m", "hinaa_api.platform.queue"]
