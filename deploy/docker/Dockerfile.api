# ==========================================
# HINAA OS - Phase 17 API Production Dockerfile
# Multi-stage, minimal attack surface, non-root
# ==========================================

# Stage 1: Build & Dependencies
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/requirements.txt* /build/

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt || \
    pip install --no-cache-dir --prefix=/install fastapi uvicorn pydantic sqlalchemy httpx redis

# Stage 2: Minimal Runtime
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

# Security: Create unprivileged system group & user (UID 10001)
RUN groupadd -g 10001 hinaa && \
    useradd -u 10001 -g hinaa -s /bin/sh -m -d /home/hinaa hinaa

# Install runtime OS dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy installed python packages from builder
COPY --from=builder /install /usr/local

# Copy application source code
COPY apps/api/hinaa_api /app/hinaa_api
COPY apps/api/pyproject.toml /app/

# Setup persistent data directories with non-root ownership
RUN mkdir -p /app/data /app/backups && \
    chown -R hinaa:hinaa /app /home/hinaa

USER hinaa:hinaa

ENV PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1 \
    HINAA_DEPLOYMENT_PROFILE=CLOUD_PRODUCTION \
    HINAA_DATABASE_URL="sqlite:////app/data/hinaa_autopilot.db"

# Container Healthcheck using native probe
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health/live || exit 1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "hinaa_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
