{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hinaa.local/schemas/realtime-event/1.0.json",
  "title": "HINAA realtime event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "eventId", "sessionId", "sequence", "timestamp", "type", "payload"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "eventId": {"type": "string", "format": "uuid"},
    "sessionId": {"type": "string", "format": "uuid"},
    "turnId": {"type": ["string", "null"], "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "type": {
      "enum": [
        "session.started", "microphone.started", "microphone.stopped", "user.audio.chunk",
        "user.transcript.partial", "user.transcript.final", "assistant.turn.started",
        "assistant.text.delta", "assistant.text.completed", "assistant.emotion.changed",
        "assistant.motion.cue", "assistant.viseme.frame", "assistant.audio.chunk",
        "assistant.audio.completed", "assistant.interrupted", "provider.fallback",
        "tool.approval.required", "error", "session.completed"
      ]
    },
    "payload": {"oneOf": [
      {"$ref": "#/$defs/sessionStarted"}, {"$ref": "#/$defs/microphone"}, {"$ref": "#/$defs/audioChunk"},
      {"$ref": "#/$defs/transcript"}, {"$ref": "#/$defs/turnStarted"}, {"$ref": "#/$defs/text"},
      {"$ref": "#/$defs/emotion"}, {"$ref": "#/$defs/motion"}, {"$ref": "#/$defs/viseme"},
      {"$ref": "#/$defs/audioCompleted"}, {"$ref": "#/$defs/interrupted"}, {"$ref": "#/$defs/fallback"},
      {"$ref": "#/$defs/toolApproval"}, {"$ref": "#/$defs/error"}, {"$ref": "#/$defs/completed"}
    ]}
  },
  "allOf": [
    {"if":{"properties":{"type":{"const":"session.started"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/sessionStarted"}}}},
    {"if":{"properties":{"type":{"enum":["microphone.started","microphone.stopped"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/microphone"}}}},
    {"if":{"properties":{"type":{"enum":["user.audio.chunk","assistant.audio.chunk"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/audioChunk"}}}},
    {"if":{"properties":{"type":{"enum":["user.transcript.partial","user.transcript.final"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/transcript"}}}},
    {"if":{"properties":{"type":{"const":"assistant.turn.started"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/turnStarted"}}}},
    {"if":{"properties":{"type":{"enum":["assistant.text.delta","assistant.text.completed"]}}},"then":{"properties":{"payload":{"$ref":"#/$defs/text"}}}},
    {"if":{"properties":{"type":{"const":"assistant.emotion.changed"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/emotion"}}}},
    {"if":{"properties":{"type":{"const":"assistant.motion.cue"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/motion"}}}},
    {"if":{"properties":{"type":{"const":"assistant.viseme.frame"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/viseme"}}}},
    {"if":{"properties":{"type":{"const":"assistant.audio.completed"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/audioCompleted"}}}},
    {"if":{"properties":{"type":{"const":"assistant.interrupted"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/interrupted"}}}},
    {"if":{"properties":{"type":{"const":"provider.fallback"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/fallback"}}}},
    {"if":{"properties":{"type":{"const":"tool.approval.required"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/toolApproval"}}}},
    {"if":{"properties":{"type":{"const":"error"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/error"}}}},
    {"if":{"properties":{"type":{"const":"session.completed"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/completed"}}}}
  ],
  "$defs": {
    "sessionStarted": {"type":"object","additionalProperties":false,"required":["capabilities"],"properties":{"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"resumeExpiresAt":{"type":"string","format":"date-time"}}},
    "microphone": {"type":"object","additionalProperties":false,"required":["reason"],"properties":{"reason":{"type":"string","maxLength":120},"codec":{"enum":["audio/pcm","audio/webm;codecs=opus","audio/ogg;codecs=opus"]},"sampleRate":{"type":"integer","minimum":8000,"maximum":48000},"channels":{"enum":[1,2]}}},
    "audioChunk": {"type":"object","additionalProperties":false,"required":["streamId","chunkIndex","codec","byteLength"],"properties":{"streamId":{"type":"string","format":"uuid"},"chunkIndex":{"type":"integer","minimum":0},"codec":{"type":"string","maxLength":64},"sampleRate":{"type":"integer","minimum":8000,"maximum":48000},"channels":{"enum":[1,2]},"byteLength":{"type":"integer","minimum":0,"maximum":262144},"dataBase64":{"type":"string","maxLength":349528}}},
    "transcript": {"type":"object","additionalProperties":false,"required":["text","language"],"properties":{"text":{"type":"string","maxLength":8000},"language":{"enum":["ne-NP","en-US","hi-IN","mixed","und"]},"confidence":{"type":"number","minimum":0,"maximum":1},"stability":{"type":"number","minimum":0,"maximum":1}}},
    "turnStarted": {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["cascade","realtime","mock"]},"providerRoute":{"type":"array","items":{"type":"string","maxLength":80}}}},
    "text": {"type":"object","additionalProperties":false,"required":["text"],"properties":{"text":{"type":"string","maxLength":8000},"deltaIndex":{"type":"integer","minimum":0},"language":{"enum":["ne-NP","en-US","hi-IN","mixed"]}}},
    "emotion": {"type":"object","additionalProperties":false,"required":["primary","intensity"],"properties":{"primary":{"enum":["neutral","happy","excited","playful","shy","concerned","sad","surprised","thinking"]},"intensity":{"type":"number","minimum":0,"maximum":1},"valence":{"type":"number","minimum":-1,"maximum":1},"arousal":{"type":"number","minimum":-1,"maximum":1}}},
    "motion": {"type":"object","additionalProperties":false,"required":["face","gesture","gaze","headMotion","atMs"],"properties":{"face":{"enum":["neutral","soft_smile","big_smile","blush","pout","concerned","surprised","thinking"]},"gesture":{"enum":["none","small_nod","head_shake","gentle_head_tilt","wave","explain","celebrate","reassure","listening_lean"]},"gaze":{"enum":["camera","down","away","user-content"]},"headMotion":{"enum":["none","subtle","nod","shake"]},"atMs":{"type":"integer","minimum":0},"intensity":{"type":"number","minimum":0,"maximum":1}}},
    "viseme": {"type":"object","additionalProperties":false,"required":["atMs","a","i","u","e","o"],"properties":{"atMs":{"type":"integer","minimum":0},"a":{"type":"number","minimum":0,"maximum":1},"i":{"type":"number","minimum":0,"maximum":1},"u":{"type":"number","minimum":0,"maximum":1},"e":{"type":"number","minimum":0,"maximum":1},"o":{"type":"number","minimum":0,"maximum":1}}},
    "audioCompleted": {"type":"object","additionalProperties":false,"required":["streamId","durationMs"],"properties":{"streamId":{"type":"string","format":"uuid"},"durationMs":{"type":"integer","minimum":0}}},
    "interrupted": {"type":"object","additionalProperties":false,"required":["reason","lastAcceptedSequence"],"properties":{"reason":{"enum":["barge-in","cancelled","provider","session-ended"]},"lastAcceptedSequence":{"type":"integer","minimum":0}}},
    "fallback": {"type":"object","additionalProperties":false,"required":["from","to","reason","userMessage"],"properties":{"from":{"type":"string","maxLength":80},"to":{"type":"string","maxLength":80},"reason":{"enum":["timeout","rate_limit","unhealthy","unsupported","privacy","quota","invalid_response"]},"userMessage":{"type":"string","maxLength":300}}},
    "toolApproval": {"type":"object","additionalProperties":false,"required":["requestId","preview","expiresAt"],"properties":{"requestId":{"type":"string","format":"uuid"},"preview":{"type":"string","maxLength":1000},"expiresAt":{"type":"string","format":"date-time"}}},
    "error": {"type":"object","additionalProperties":false,"required":["code","message","retryable","userActionRequired","correlationId"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},"message":{"type":"string","maxLength":500},"retryable":{"type":"boolean"},"userActionRequired":{"type":"boolean"},"correlationId":{"type":"string","format":"uuid"}}},
    "completed": {"type":"object","additionalProperties":false,"required":["reason"],"properties":{"reason":{"enum":["normal","cancelled","expired","error"]}}}
  }
}
