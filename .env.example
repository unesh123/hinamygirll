# Public client configuration (never secrets)
HINAA_PUBLIC_API_BASE_URL=
HINAA_PUBLIC_DEFAULT_LOCALE=ne-NP
HINAA_PUBLIC_ENABLE_CAMERA_EXPERIMENT=false

# Server runtime
HINAA_ENVIRONMENT=local
HINAA_DATABASE_URL=
HINAA_SESSION_SIGNING_KEY_REF=
HINAA_ALLOWED_ORIGINS=
HINAA_PROVIDER_CONFIG_PATH=
HINAA_DEFAULT_LLM_PROVIDER=mock
HINAA_DEFAULT_LLM_MODEL_ID=
HINAA_DEFAULT_STT_PROVIDER=mock
HINAA_DEFAULT_TTS_PROVIDER=mock
HINAA_AZURE_SPEECH_REGION=
HINAA_AZURE_SPEECH_KEY_REF=
HINAA_GEMINI_API_KEY_REF=
HINAA_KMS_KEY_ID=
HINAA_OBJECT_STORAGE_ENDPOINT=
HINAA_OBJECT_STORAGE_BUCKET=
HINAA_REDIS_URL=
HINAA_OTEL_EXPORTER_ENDPOINT=
HINAA_MONTHLY_BUDGET_MINOR_UNITS=

# Tier A conversation brain (non-secret)
HINAA_DEFAULT_COMPANION=hinaa
HINAA_SESSION_HISTORY_CHAR_LIMIT=32000
HINAA_PROMPT_DEBUG_METADATA=false
HINAA_PERSONALITY_AFFECTION=0.55
HINAA_PERSONALITY_SASS=0.25
HINAA_PERSONALITY_ENERGY=0.55
HINAA_PERSONALITY_HUMOR=0.4
HINAA_PERSONALITY_PROACTIVITY=0.35

# Long-form generation (ChatGPT-style documents/reports)
# Max output tokens per LLM call; the continuation loop can extend a turn
# up to llm_max_continuations times beyond this.
# HINAA_LLM_MAX_OUTPUT_TOKENS=16384
# HINAA_LLM_STREAM_CHAR_BUDGET=200000
# HINAA_LLM_MAX_CONTINUATIONS=4
# HINAA_LLM_TIMEOUT_SECONDS=300
# HINAA_LLM_STREAM_IDLE_TIMEOUT_SECONDS=75

# GitHub work-tree connection (repo tools)
# GITHUB_TOKEN=
# HINAA_GITHUB_DEFAULT_REPO=owner/name

# Exa API (Semantic search and documentation extraction for coding agent)
# EXA_API_KEY=

# Experiential Labs Gateway (for claude-opus-5.5 at https://api.experientiallabs.ai/v1)
# EXPLABS_API_KEY=

# Paid provider gate (must stay unset/false in normal CI)
# HINAA_ALLOW_PAID_PROVIDER_TEST=1
# HINAA_PAID_PROVIDER_TEST_CONFIRM=I_UNDERSTAND_THIS_MAY_COST_MONEY

# Persistence / auth (non-secret)
HINAA_DATABASE_URL=sqlite+pysqlite:///:memory:
HINAA_AUTH_MODE=dev
HINAA_DEV_AUTH_SUBJECT=local-dev-user
HINAA_PERSISTENCE_ENABLED=true
# HINAA_OIDC_ISSUER=
# HINAA_ALLOW_OIDC_SCAFFOLD_TOKENS=false

# Provider timeouts
# Media calls (STT/TTS) fail fast; the brain (LLM) gets a large budget because
# reasoning models (cx/gpt-5.6-sol) spend hidden tokens before the first token
# and long documents take minutes to stream.
# HINAA_LLM_TIMEOUT_SECONDS=300

# UpCloud provisioning gate (must stay unset in normal CI)
# HINAA_ALLOW_UPCLOUD_PROVISIONING=1
# HINAA_UPCLOUD_PROVISIONING_CONFIRM=I_AUTHORIZE_STAGING_RESOURCES

# ElevenLabs TTS Server Configuration (Server-Side Only - Never Expose to Client)
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_VOICE_ID=WUgmmuDCpFXQ4z0NUUYX  (Hina's voice; the code default already uses it)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Paid provider gates
# HINAA_ALLOW_ELEVENLABS_TEST=1
# HINAA_ELEVENLABS_TEST_CONFIRM=I_UNDERSTAND_THIS_MAY_COST_MONEY

# Third-party integrations (server-side only; names only, set values in your private .env)
GITHUB_TOKEN=
HINAA_GITHUB_DEFAULT_REPO=
EXA_API_KEY=
TINYFISH_API_KEY=
GAMMA_AI_API_KEY=
# CustomGPT: APP_CUSTOMGPT_AI_API_KEY is read first; misspelled APP_COUSTOMGPT_AI_API_KEY is a legacy fallback
APP_CUSTOMGPT_AI_API_KEY=
APP_CUSTOMGPT_AI_BASE_URL=
FREEPIK_API_KEY=
BROWSER_USE_API_KEY=
CAPSOLVER_API_KEY=
EZ_CAPTCHA_API_KEY=
HINAA_TREG_TOKEN=
OUTLOOK_ACCESS_TOKEN=
NOTION_API_KEY=
SPOTIFY_CLIENT_ID=
# Set false to stop injecting SKILL.md playbooks into prompts
HINAA_RUNTIME_SKILLS_ENABLED=true

# Telephony (Twilio) - see docs/telephony.md. Values go in .env.local, never here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HINAA_OWNER_PHONE_NUMBER=
HINAA_PUBLIC_BASE_URL=
HINAA_TELEPHONY_ALLOWED_NUMBERS=
HINAA_TELEPHONY_MAX_CALLS_PER_HOUR=5
HINAA_TELEPHONY_USER_ID=
HINAA_TELEPHONY_PROACTIVE=false

# Never add actual credentials to this file. *_REF values identify server secret-store entries.


# Operations hardening - see docs/operations.md (names only; set values in the host env)
HINAA_LOG_FORMAT=
HINAA_CORS_ORIGINS=
HINAA_CORS_ORIGIN_REGEX=
HINAA_METRICS_TOKEN=
HINAA_MAX_BODY_BYTES=
HINAA_MAX_UPLOAD_BYTES=
HINAA_RATE_LIMIT_ENABLED=
HINAA_RATE_LIMIT_PER_MINUTE=
HINAA_RATE_LIMIT_EXPENSIVE_PER_MINUTE=
HINAA_TRUST_PROXY=
HINAA_OTEL_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# PC control + WhatsApp (see docs/pc-control-and-whatsapp.md)
HINAA_PROJECTS_ROOT=
HINAA_IDE_COMMAND=
HINAA_IDE_AGENT_SHORTCUT=
HINAA_COMPUTER_DRY_RUN=
HINAA_WHATSAPP_ALLOWED_CHATS=
HINAA_WHATSAPP_AUTOSEND_TO_ALLOWED=
HINAA_WHATSAPP_PROFILE_DIR=
HINAA_WHATSAPP_HEADLESS=

# News AI + social publishing (names only; set values in the host env)
HINAA_NEWS_SCHEDULER_ENABLED=
HINAA_NEWS_TICK_SECONDS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
HINAA_SOCIAL_TOKEN_KEY=
HINAA_SOCIAL_MEDIA_ROOT=

# Enterprise identity (names only; see docs/identity-and-rbac.md)
# Server pepper for API-key and IP hashes. If unset, one is generated into .runtime/api_key_pepper (mode 0600).
HINAA_API_KEY_PEPPER=
