# Public client configuration (never secrets)
HINAA_PUBLIC_API_BASE_URL=
HINAA_PUBLIC_DEFAULT_LOCALE=ne-NP
HINAA_PUBLIC_ENABLE_CAMERA_EXPERIMENT=false

# Server runtime
HINAA_ENVIRONMENT=local
HINAA_DATABASE_URL=
HINAA_SESSION_SIGNING_KEY_REF=
HINAA_ALLOWED_ORIGINS=
HINAA_PROVIDER_CONFIG_PATH=
HINAA_DEFAULT_LLM_PROVIDER=mock
HINAA_DEFAULT_LLM_MODEL_ID=
HINAA_DEFAULT_STT_PROVIDER=mock
HINAA_DEFAULT_TTS_PROVIDER=mock
HINAA_AZURE_SPEECH_REGION=
HINAA_AZURE_SPEECH_KEY_REF=
HINAA_GEMINI_API_KEY_REF=
HINAA_KMS_KEY_ID=
HINAA_OBJECT_STORAGE_ENDPOINT=
HINAA_OBJECT_STORAGE_BUCKET=
HINAA_REDIS_URL=
HINAA_OTEL_EXPORTER_ENDPOINT=
HINAA_MONTHLY_BUDGET_MINOR_UNITS=

# Tier A conversation brain (non-secret)
HINAA_DEFAULT_COMPANION=hinaa
HINAA_SESSION_HISTORY_CHAR_LIMIT=4000
HINAA_PROMPT_DEBUG_METADATA=false
HINAA_PERSONALITY_AFFECTION=0.55
HINAA_PERSONALITY_SASS=0.25
HINAA_PERSONALITY_ENERGY=0.55
HINAA_PERSONALITY_HUMOR=0.4
HINAA_PERSONALITY_PROACTIVITY=0.35

# Paid provider gate (must stay unset/false in normal CI)
# HINAA_ALLOW_PAID_PROVIDER_TEST=1
# HINAA_PAID_PROVIDER_TEST_CONFIRM=I_UNDERSTAND_THIS_MAY_COST_MONEY

# Persistence / auth (non-secret)
HINAA_DATABASE_URL=sqlite+pysqlite:///:memory:
HINAA_AUTH_MODE=dev
HINAA_DEV_AUTH_SUBJECT=local-dev-user
HINAA_PERSISTENCE_ENABLED=true
# HINAA_OIDC_ISSUER=
# HINAA_ALLOW_OIDC_SCAFFOLD_TOKENS=false

# Provider timeouts
# Media calls (STT/TTS) fail fast; the brain (LLM) gets a large budget because
# reasoning models (cx/gpt-5.6-sol) spend hidden tokens before the first token.
# HINAA_LLM_TIMEOUT_SECONDS=60

# UpCloud provisioning gate (must stay unset in normal CI)
# HINAA_ALLOW_UPCLOUD_PROVISIONING=1
# HINAA_UPCLOUD_PROVISIONING_CONFIRM=I_AUTHORIZE_STAGING_RESOURCES

# ElevenLabs TTS Server Configuration (Server-Side Only - Never Expose to Client)
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Paid provider gates
# HINAA_ALLOW_ELEVENLABS_TEST=1
# HINAA_ELEVENLABS_TEST_CONFIRM=I_UNDERSTAND_THIS_MAY_COST_MONEY

# Never add actual credentials to this file. *_REF values identify server secret-store entries.

